{
  "name": "ganesh-ai-brain",
  "version": "2.0.0",
  "type": "module",
  "description": "Ganesh AI Brain — Multi-Agent Orchestrator, Role Stack Pipeline, Watchdog & B2B Telemetry Core",
  "main": "brain-server/index.mjs",
  "scripts": {
    "start": "node brain-server/index.mjs",
    "dev": "node brain-server/index.mjs",
    "brain:ui:build": "npm install --prefix brain-server/ui && npm run build --prefix brain-server/ui",
    "build": "npm run brain:ui:build",
    "test": "node --test 'lib/geo-pipeline/*.test.mjs' 'brain-server/test/*.test.mjs'",
    "test:orchestrator": "npx tsx test.ts",
    "verify": "node scripts/verify-generation.mjs",
    "verify:fast": "node scripts/verify-generation.mjs --fast",
    "watchdog:run": "node scripts/run-watchdog.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "mcp:onyx-lynx": "npm --prefix onyx-lynx-mcp-server start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jose": "^6.2.4",
    "stripe": "^22.2.1",
    "xstate": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0"
  }
}
