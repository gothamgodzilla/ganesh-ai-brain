# Copy to .env and fill in. Never commit the real .env file.

# --- Onyx (discovery) ---
# Google Cloud Console -> APIs & Services -> enable "Places API" + "Geocoding API"
GOOGLE_MAPS_API_KEY=

# From MASTERLIST.md — use a MapKit/Server-API-enabled key, not the "AI Build" APNs key (3MPBZVJFKG)
APPLE_TEAM_ID=854XZ2543V
APPLE_MAPKIT_KEY_ID=
APPLE_MAPKIT_P8_PATH=./certs/AuthKey_XXXXXXXXXX.p8

# Already in your masterlist as YELP_API_KEY / MANGASM_YELP_API_KEY
YELP_API_KEY=

# WHITEPAGES_API_KEY=   # intentionally unused by the stub tool — see README

# --- Lynx (outreach) ---
# Already in your masterlist as RESEND_API_KEY (bae@slay.llc account)
RESEND_API_KEY=

# --- Opt-out service (src/unsubscribe-server.ts, runs as its own process) ---
# Public base URL where that service is deployed. Set this and Lynx auto-generates
# signed unsubscribe links; leave unset and you must pass unsubscribe_url per send.
UNSUBSCRIBE_BASE_URL=
# Signs opt-out tokens so links can't be forged or enumerated. Generate with:
#   openssl rand -hex 32
UNSUBSCRIBE_TOKEN_SECRET=
UNSUBSCRIBE_PORT=3001

# stdio (default, for local MCP clients) or http (for a remote deployment)
TRANSPORT=stdio
PORT=3000
