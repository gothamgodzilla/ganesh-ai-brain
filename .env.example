# GaneshAI — Multi-Agent MCP Engine
# cp .env.example .env

OUTPUT_DIR=./output
EIN_GATE_SECRET=your-secure-random-secret-min-32-chars

# Playwright scout — live zip batch (10 businesses × 3 rounds × 30s)
SCOUT_LIVE=true
PLAYWRIGHT_HEADLESS=true
SCOUT_TIMEOUT_MS=45000
# Default ship on pipeline:full — deploy preview hub + verify 200 + live email
# Override per run: npm run pipeline:full -- --zip 90855 --no-ship
PIPELINE_SHIP=true

SCOUT_BATCH_SIZE=20
SCOUT_BATCH_ROUNDS=3
SCOUT_BATCH_INTERVAL_MS=5000
SCOUT_RATE_LIMIT=10
SCOUT_RATE_WINDOW_MS=60000
SCOUT_ENRICH_CONCURRENCY=3
SCOUT_RADIUS_MILES=50
# Starlink terminal (optional — ties pipeline runs to your dish; keep in .env only)
# STARLINK_SERIAL_NUMBER=4PBAxxxxxxxxSWB
# STARLINK_ID=xxxxxxxx-xxxxxxxx-xxxxxxxx
# STARLINK_ROUTER_ID=010000000000000001xxxxxx
# STARLINK_ROUTER_VERSION=2026.05.28.mr78329.3

# Device fleet — iPhone 15 / iPad parallel scout workers (LAN server + PWA)
# FLEET_PORT=8765
# Mac LAN IP — bookmark this on iPhone (changes when router/WiFi changes)
FLEET_HOST=192.168.1.69
# Listen on all interfaces so Starlink/router IP changes do not break fleet login
FLEET_BIND_HOST=0.0.0.0
# Use a dedicated secret — do NOT reuse BRAIN_SYNC_SECRET
# FLEET_SECRET=generate-a-long-random-string
# FLEET_WAIT_MS=120000
# FLEET_FETCH_ENRICH_CONCURRENCY=8
# FLEET_GPU_ENRICH=true
# FLEET_CATEGORIES=restaurant,bar,salon,gym,auto,dispensary

# Starlink / satellite — Worker edge scout, skip local Places (CGNAT REQUEST_DENIED)
# SCOUT_PROFILE=starlink
# SCOUT_PLACES_LOCAL_ENABLED=false
# SCOUT_ENRICH_WALL_MS=10000
# SCOUT_MAPS_WALL_MS=20000
# AUDIT_LIVE_MAX=50
# Enrichment layer — NAP normalize, dedupe, geo audit, website HEAD verify
# SCOUT_ENRICH_STRICT=true rejects false-positive locations + dead websites
SCOUT_DUMP_HTML=true

# Email outreach — warm accounts rotate as senders
WARM_EMAIL_ACCOUNTS=hello@your-domain.com,warm-sender@example.com
CREATE_MAIL_DRAFTS=true
EMAIL_DRAFT_METHOD=mail_app
# Live send via Worker /send-email after draft creation (Resend — ceo.slay.llc)
SEND_LIVE_EMAIL=false
FROM_EMAIL=hello@your-domain.com
PITCH_FROM_EMAIL=hello@your-domain.com
# Preview host — must align with FROM_EMAIL domain for deliverability
PREVIEW_DOMAIN=preview.ceo.slay.llc
PREVIEW_BASE_URL=https://preview.ceo.slay.llc

# Hosted preview — brochure + site links in outreach emails
EMAIL_ALLOW_GUESSES=true

# Vercel one-command deploy
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_Qaot4UGuHC1uw3Ev9xNhKLjkfylo
VERCEL_TEAM_ID=
VERCEL_ORG_ID=
# Deployment Protection bypass — Vercel → Project → Settings → Deployment Protection
# Sent as x-vercel-protection-bypass on *.vercel.app fetches (scout, verify, pre-send probe)
VERCEL_AUTOMATION_BYPASS_SECRET=

# Stripe — B2B AGENCY account (luxury outreach / $499 Payment Link)
# NOT Mangasm iOS — use the account where buy.stripe.com/aFaeVc2FZaNla1ScJd8bS00 was created.
# Dashboard: top-left switcher → agency profile → Developers → API keys
STRIPE_ACCOUNT_ID=acct_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_BUY_BUTTON_ID=buy_btn_REPLACE_ME
STRIPE_PRODUCT_ID_COHORT=prod_REPLACE_ME
STRIPE_PRICE_ID_COHORT=price_REPLACE_ME
STRIPE_PRODUCT_ID_STANDARD=prod_REPLACE_ME
STRIPE_PRICE_ID_STANDARD=price_REPLACE_ME
# sk_live_ full secret (webhooks admin) OR rk_live_ restricted (read/stats)
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
CHECKOUT_BASE_URL=https://checkout.mangasm.io
# Live Stripe Payment Links (Apple Pay on Stripe-hosted checkout)
# Dashboard shows pmd_xxx — shareable link is buy.stripe.com/{slug} (slug = id without pmd_ prefix)
STRIPE_LIVE_LINK=https://buy.stripe.com/YOUR_LIVE_PRODUCTION_LINK_HERE
STRIPE_PAYMENT_METHOD_DOMAIN_ID=pmd_YOUR_DOMAIN_ID_HERE
STRIPE_LIVE_LINK_BASIC=https://buy.stripe.com/YOUR_BASIC_LINK_HERE
STRIPE_LIVE_LINK_PRO=https://buy.stripe.com/YOUR_PRO_LINK_HERE
STRIPE_LIVE_LINK_PREMIUM=https://buy.stripe.com/YOUR_PREMIUM_LINK_HERE
STRIPE_LIVE_LINK_STANDARD=https://buy.stripe.com/YOUR_1499_STANDARD_LINK_HERE

# Supabase Postgres Storage (for Brain Serverless State)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Core Dashboard Analytics Core
# Path B (folded brain): run `npm run brain:server` on your Repl, then point here at that URL.
# Branded Monitoring Core
GANESH_AI_BRAIN_URL="https://ganesh.guru"
STRIPE_MONITOR_WEBHOOK="https://ganesh.guru/api/v1/stripe/webhook"
BRAIN_DASHBOARD_URL=https://ganesh.guru
BRAIN_SYNC_SECRET=generate-a-long-random-string
API_INTERNAL_KEY=generate-a-long-random-secret

# DASHBOARD_VIEW_TOKEN — private view token for Brain telemetry UI.
# Paste the SAME value on Replit Secrets and Mac luxury-mcp-engine/.env (byte-for-byte).
# Sign in at GET /brain (POST /api/brain/auth) — stored as HttpOnly cookie, never in URL.
# API access: Authorization: Bearer … · x-dashboard-token · session cookie
# Without it on Replit: revenue totals, conversion counts, and client IDs stay PUBLIC.
# Generate: openssl rand -hex 32
DASHBOARD_VIEW_TOKEN=generate-a-long-random-secret
ALLOWED_ORIGINS=https://preview.ceo.slay.llc,https://ceo.slay.llc
# BRAIN_PORT=5055
# Replit deploy orchestrator (npm run replit:deploy) — token from replit.com/account#api-tokens
# REPLIT_API_TOKEN=
# REPLIT_REPL_ID=b2a4afbd-84d3-40f7-a1d9-0b43aec47d7a
# REPLIT_STATIC_DEPLOYMENT_ID=43141b24-099d-4d3c-9040-c3bd0d0b458d
# TRUST_PROXY=1 — reverse-proxy hops for req.ip (use "true" on Replit if all clients share one bucket)
# AUTH_FAIL_MAX=12 — failed logins per client IP per 15 min before 429
# Monitor Control Matrix:
#   GaneshAI Brain App     → GANESH_AI_BRAIN_URL
#   Live Telemetry Pipe    → STRIPE_MONITOR_WEBHOOK (/api/v1/stripe/webhook)
#   Frictionless Gate      → STRIPE_LIVE_LINK (buy.stripe.com/...Jd8bS00)

# RevenueCat — public key for client SDK / browser test page
REVENUECAT_PUBLIC_KEY=your_public_key_here
# RevenueCat — secret key for server-side API (never commit, never put in HTML)
REVENUECAT_API_KEY=

# Delivery
VIDEO_TUTORIAL_URL=https://tutorials.mangasm.io

# Inngest — durable pipeline steps (scout → per-business pipeline → summary)
INNGEST_APP_ID=ganeshai-luxury-engine
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_SERVE_PORT=8288

# MCP
MCP_SERVER_NAME=ganeshai-engine

# Scout fallback chain (when Command Center / Playwright stuck):
#   auto → Worker → Places API → Playwright → quick-scout
#   places → Google Places API only (fastest for scale — 1000s/day)
#   worker → Worker + Places, skip Playwright
#   bypass → quick-scout list only
SCOUT_MODE=auto

# Google Places API — Plan B backup (enable Places API + Geocoding in Google Cloud)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
SCOUT_PLACES_API_ENABLED=true

# Cloudflare Worker Backend (Plan A scout) — requires WORKER_API_SECRET on worker + here
MCP_BACKEND=https://divine-ganesh-one.divine-ganesh-one.workers.dev
WORKER_URL=https://divine-ganesh-one.divine-ganesh-one.workers.dev
WORKER_API_SECRET=generate-a-long-random-secret
WORKER_NAME=divine-ganesh-one
CLOUDFLARE_ACCOUNT_ID=
SCOUT_WORKER_ENABLED=true
SCOUT_WORKER_TIMEOUT_MS=15000
SCOUT_WORKER_SLOW_MS=8000
SCOUT_WORKER_MIN_BUSINESSES=1
# Starlink-tuned worker timeouts (when SCOUT_PROFILE=starlink):
# SCOUT_WORKER_TIMEOUT_MS=25000
# SCOUT_WORKER_SLOW_MS=12000