{
  "version": 2,
  "buildCommand": "npm --prefix brain-server/ui install --include=dev && npm --prefix brain-server/ui run build",
  "outputDirectory": "brain-server/console-dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{brain-server/**,lib/**,prompts/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/watchdog",
      "schedule": "0 7 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
